{
  "name": "submitly",
  "version": "0.0.0",
  "description": "Headless form submission for React and Next.js: Standard Schema validation, typed actions, server errors mapped to fields, pending/dialog locks and post-mutation refresh. Works with any UI.",
  "keywords": [
    "react",
    "nextjs",
    "react-hook-form",
    "crud",
    "forms",
    "form-submission",
    "validation",
    "headless",
    "standard-schema",
    "zod",
    "valibot",
    "server-actions"
  ],
  "license": "MIT",
  "author": {
    "name": "toony10",
    "url": "https://anton-web-portfolio.vercel.app/"
  },
  "homepage": "https://github.com/toony10/submitly#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toony10/submitly.git",
    "directory": "packages/submitly"
  },
  "bugs": {
    "url": "https://github.com/toony10/submitly/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    },
    "./next/server": {
      "types": "./dist/next/server.d.ts",
      "default": "./dist/next/server.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && node scripts/check-directives.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --typecheck",
    "test:react18": "vitest run --config vitest.react18.config.ts",
    "typecheck:react18": "tsc -p tsconfig.react18.json",
    "check-exports": "publint --strict && attw --pack . --profile esm-only",
    "size": "size-limit"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "react": ">=18.2.0",
    "react-hook-form": "^7.55.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@size-limit/preset-small-lib": "14.3.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-18": "npm:@types/react@18.3.31",
    "@types/react-dom": "19.3.0",
    "@types/react-dom-18": "npm:@types/react-dom@18.3.7",
    "arktype": "2.2.9",
    "happy-dom": "21.0.4",
    "next": "16.4.3",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-18": "npm:react@18.3.1",
    "react-dom": "19.3.1",
    "react-dom-18": "npm:react-dom@18.3.1",
    "react-hook-form": "7.91.0",
    "size-limit": "14.3.0",
    "tsdown": "0.23.2",
    "valibot": "1.5.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7",
    "zod3": "npm:zod@3.25.76"
  },
  "size-limit": [
    {
      "name": "submitly (core + react)",
      "path": "dist/index.js",
      "import": "*",
      "limit": "4 kB",
      "gzip": true
    },
    {
      "name": "submitly/core (server-safe helpers)",
      "path": "dist/core/index.js",
      "import": "*",
      "limit": "600 B",
      "gzip": true
    }
  ]
}
