{
  "name": "submitly",
  "version": "0.0.0",
  "description": "shadcn-native CRUD dialogs and form submission for React and Next.js: validation, pending locks, server errors and post-mutation refresh.",
  "keywords": [
    "react",
    "nextjs",
    "react-hook-form",
    "shadcn",
    "crud",
    "forms",
    "standard-schema",
    "server-actions"
  ],
  "license": "MIT",
  "author": "toony10",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    },
    "./next/server": {
      "types": "./dist/next/server.d.ts",
      "default": "./dist/next/server.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && node scripts/check-directives.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --typecheck",
    "check-exports": "publint --strict && attw --pack . --profile esm-only",
    "size": "size-limit"
  },
  "peerDependencies": {
    "@hookform/resolvers": "^5.0.0 || ^6.0.0",
    "next": ">=15.0.0",
    "react": ">=18.2.0",
    "react-hook-form": "^7.55.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@hookform/resolvers": "6.0.0",
    "@size-limit/preset-small-lib": "14.3.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "arktype": "2.2.9",
    "happy-dom": "21.0.4",
    "next": "16.4.3",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "size-limit": "14.3.0",
    "tsdown": "0.23.2",
    "valibot": "1.5.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7",
    "zod3": "npm:zod@3.25.76"
  },
  "size-limit": [
    {
      "name": "submitly (core + react)",
      "path": "dist/index.js",
      "import": "*",
      "limit": "4 kB",
      "gzip": true
    }
  ]
}
